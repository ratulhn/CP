//**********Binary Exponentiation (M<=1e18) ************//

ll binEx(ll a, ll b) {
    ll ans=1;
    while(b>0) {
        if(b&1) ans = binMultiply(ans,a);
        b>>=1;
        a = binMultiply(a,a);
    }
    return ans;
}

ll binMultiply(ll a, ll b) {
    ll ans=0;
    while(b>0) {
        if(b&1) ans = (ans+a)%M;
        b>>=1;
        a = (a+a)%M;
    }
    return ans;
}



